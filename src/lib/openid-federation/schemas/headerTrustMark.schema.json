{
    "title": "Header Trust Mark Schema",
    "description": "JSON Schema for validating Header Trust Mark documents as defined in OpenID Connect Federation 1.0 - draft 29. February 17, 2026.",
    "type": "object",
    "properties": {
        "alg": {
            "type": "string",
            "minLength": 1,
            "not": {
                "enum": [
                    "none",
                    "None",
                    "NONE"
                ]
            }
        },
        "kid": {
            "type": "string",
            "minLength": 1,
            "not": {
                "enum": [
                    "none",
                    "None",
                    "NONE"
                ]
            }
        },
        "typ": {
            "type": "string",
            "const": "trust-mark+jwt"
        }
    },
    "required": [
        "alg",
        "kid",
        "typ"
    ]
}