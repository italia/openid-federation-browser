{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Header Federation Historical Key Schema",
    "description": "JSON Schema for validating Federation Historical Key header as defined in OpenID Connect Federation 1.0 - February 17, 2026.",
    "type": "object",
    "properties": {
        "alg": {
            "type": "string",
            "minLength": 1,
            "not": {
                "enum": [
                    "none",
                    "None",
                    "NONE"
                ]
            }
        },
        "kid": {
            "type": "string",
            "minLength": 1,
            "not": {
                "enum": [
                    "none",
                    "None",
                    "NONE"
                ]
            }
        },
        "typ": {
            "type": "string",
            "const": "jwk-set+jwt"
        }
    },
    "required": [
        "alg",
        "kid",
        "typ"
    ]
}