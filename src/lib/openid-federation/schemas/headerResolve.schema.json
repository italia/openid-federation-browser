{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Header Resolve Schema",
    "description": "JSON Schema for validating Resolve as defined in OpenID Connect Federation 1.0 - February 17, 2026.",
    "type": "object",
    "properties": {
        "alg": {
            "type": "string"
        },
        "kid": {
            "type": "string"
        },
        "typ": {
            "type": "string",
            "const": "resolve-response+jwt"
        }
    },
    "required": [
        "alg",
        "kid",
        "typ"
    ]
}