{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trust Mark Schema",
  "description": "JSON Schema for validating Trust Mark documents as defined in OpenID Connect Federation 1.0 - draft 29. February 17, 2026.",
  "$id": "https://example.org/schemas/trust-mark.json",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+(:[0-9]+)?(/[^?#]*)?$"
    },
    "sub": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#]+(:[0-9]+)?(/[^?#]*)?$"
    },
    "iat": {
      "type": "integer",
      "minimum": 0
    },
    "exp": {
      "type": "integer",
      "minimum": 0
    },
    "id": {
      "type": "string",
      "format": "uri"
    },
    "logo_uri": {
      "type": "string",
      "format": "uri"
    },
    "ref": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "iss",
    "sub",
    "iat",
    "id"
  ],
  "additionalProperties": true
}